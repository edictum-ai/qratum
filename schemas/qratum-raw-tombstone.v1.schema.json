{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/qratum-raw-tombstone.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "data_class", "raw_ref_id", "digest", "reason", "erased_at", "blob_removed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "qratum.raw_tombstone.v1" },
    "data_class": { "const": "raw" },
    "raw_ref_id": { "type": "string" },
    "digest": { "type": "string" },
    "reason": { "type": "string" },
    "erased_at": { "type": "string" },
    "blob_removed": { "type": "boolean" }
  }
}
