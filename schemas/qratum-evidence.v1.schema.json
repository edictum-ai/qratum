{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/qratum-evidence.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "data_class", "session_id", "summary", "findings", "missing_evidence", "artifact_paths"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "qratum.evidence.v1" },
    "data_class": { "const": "review" },
    "session_id": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["status", "source", "files_changed", "commands_run", "tests_run"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "complete" },
        "source": { "const": "claude-code" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "source_event_id": { "type": "string" },
        "source_event_type": { "enum": ["session_start", "session_end"] },
        "source_event_timestamp": { "type": "string" },
        "files_changed": { "type": "integer" },
        "commands_run": { "type": "integer" },
        "tests_run": { "type": "integer" },
        "last_file_change_at": { "type": "string" },
        "last_test_command_at": { "type": "string" },
        "last_successful_verification_at": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "title", "summary", "evidence", "missing_evidence"],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "type": "string" },
          "type": {
            "enum": [
              "verification.final_edit_after_last_test",
              "verification.missing_final_verification",
              "verification.final_verification_failed",
              "verification.only_failed_verification",
              "reliability.repeated_failing_command",
              "tool_risk.destructive_command",
              "tool_risk.network_call_without_need",
              "scope.source_changed_without_test_change",
              "scope.broad_file_change"
            ]
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "kind"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "kind": { "enum": ["file_change", "command"] },
                "timestamp": { "type": "string" },
                "path": { "type": "string" },
                "operation": { "type": "string" },
                "command": { "type": "string" },
                "success": { "type": "boolean" },
                "output_excerpt": { "type": "string" }
              }
            }
          },
          "missing_evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "source_event_id": { "type": "string" },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": { "type": "string" },
        "session": { "type": "string" },
        "redacted": { "type": "string" },
        "evidence": { "type": "string" },
        "review": { "type": "string" },
        "report": { "type": "string" },
        "export": { "type": "string" }
      }
    }
  }
}
