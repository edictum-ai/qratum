{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/qratum-raw-ref.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "raw_ref_id", "source", "kind", "digest", "original_path", "archived_path", "size_bytes", "observed_at", "local_only"],
  "properties": {
    "schema_version": { "const": "qratum.raw_ref.v1" },
    "raw_ref_id": { "type": "string" },
    "source": { "type": "string" },
    "source_session_id": { "type": "string" },
    "kind": {
      "enum": [
        "main_transcript",
        "subagent_transcript",
        "file_history_snapshot",
        "source_insight_report",
        "source_metadata",
        "source_export_bundle",
        "source_memory",
        "vendor_memory_dir",
        "vendor_insight_report",
        "memory_import_receipt",
        "unknown"
      ]
    },
    "digest": { "type": "string" },
    "original_path": { "type": "string" },
    "archived_path": { "type": "string" },
    "size_bytes": { "type": "integer" },
    "observed_at": { "type": "string" },
    "local_only": { "const": true }
  }
}
