{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/qratum-price-catalog-manifest.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "data_class", "catalog_id", "upstream", "digest", "retrieved_at", "retrieval_method", "currency", "transform_version", "entry_count"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "qratum.price_catalog_manifest.v1" },
    "data_class": { "const": "published" },
    "catalog_id": { "type": "string" },
    "upstream": { "type": "string" },
    "resolved_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "retrieval_method": { "enum": ["bundled", "online", "file"] },
    "source_url": { "type": "string" },
    "currency": { "type": "string" },
    "effective_at": { "type": "string" },
    "transform_version": { "type": "string" },
    "entry_count": { "type": "integer" }
  },
  "if": { "properties": { "retrieval_method": { "const": "online" } }, "required": ["retrieval_method"] },
  "then": { "required": ["resolved_commit", "source_url"] }
}
