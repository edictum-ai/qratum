{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/ui/session-detail.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "data_class", "session_id", "source", "repo", "time", "summary", "review", "findings", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "qratum.ui.session_detail.v1" },
    "data_class": { "const": "published" },
    "session_id": { "type": "string" },
    "source": { "type": "string" },
    "agent_model": { "type": "string" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "type": "string" },
        "repo_id": { "type": "string" },
        "cwd": { "type": "string" },
        "git_remote": { "type": "string" },
        "git_branch": { "type": "string" },
        "git_head_sha": { "type": "string" }
      }
    },
    "time": {
      "type": "object",
      "required": ["duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "duration_seconds": { "type": "integer" },
        "source_event_timestamp": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "turns", "tool_calls", "files_changed", "commands_run", "tests_run", "missing_evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "source_event_id": { "type": "string" },
        "source_event_type": { "enum": ["session_start", "session_end"] },
        "source_event_timestamp": { "type": "string" },
        "source_transcript_session_id": { "type": "string" },
        "turns": { "type": "integer" },
        "tool_calls": { "type": "integer" },
        "files_changed": { "type": "integer" },
        "commands_run": { "type": "integer" },
        "tests_run": { "type": "integer" },
        "missing_evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "required": ["schema_version", "data_class", "session_id", "verdict", "main_finding", "evidence", "suggested_next_habit", "warnings", "findings", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "qratum.ui.review_card.v1" },
        "data_class": { "const": "published" },
        "session_id": { "type": "string" },
        "verdict": { "enum": ["clean", "needs_attention"] },
        "main_finding": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "suggested_next_habit": { "type": "string" },
        "suggested_skill": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["schema_version", "data_class", "finding_id", "type", "severity", "confidence", "title", "summary", "evidence", "missing_evidence"],
            "additionalProperties": false,
            "properties": {
              "schema_version": { "const": "qratum.ui.evidence_finding.v1" },
              "data_class": { "const": "published" },
              "finding_id": { "type": "string" },
              "type": {
                "enum": [
                  "verification.final_edit_after_last_test",
                  "verification.missing_final_verification",
                  "verification.final_verification_failed",
                  "verification.only_failed_verification",
                  "reliability.repeated_failing_command",
                  "tool_risk.destructive_command",
                  "tool_risk.network_call_without_need",
                  "scope.source_changed_without_test_change",
                  "scope.broad_file_change"
                ]
              },
              "severity": { "enum": ["low", "medium", "high"] },
              "confidence": { "enum": ["medium", "high"] },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "kind", "display"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string" },
                    "kind": { "enum": ["file_change", "command"] },
                    "display": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "path": { "type": "string" },
                    "operation": { "type": "string" },
                    "command": { "type": "string" },
                    "success": { "type": "boolean" },
                    "output_excerpt": { "type": "string" }
                  }
                }
              },
              "missing_evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["schema_version", "data_class", "artifact_id", "session_id", "type", "label", "media_type", "href", "digest", "created_at"],
            "additionalProperties": false,
            "properties": {
              "schema_version": { "const": "qratum.ui.artifact_link.v1" },
              "data_class": { "const": "published" },
              "artifact_id": { "type": "string" },
              "session_id": { "type": "string" },
              "type": { "enum": ["html_report", "adp_strict_export", "redacted_session", "evidence_bundle", "review_card", "share_card"] },
              "label": { "type": "string" },
              "media_type": { "type": "string" },
              "href": { "type": "string" },
              "digest": { "type": "string" },
              "created_at": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "data_class", "finding_id", "type", "severity", "confidence", "title", "summary", "evidence", "missing_evidence"],
        "additionalProperties": false,
        "properties": {
          "schema_version": { "const": "qratum.ui.evidence_finding.v1" },
          "data_class": { "const": "published" },
          "finding_id": { "type": "string" },
          "type": {
            "enum": [
              "verification.final_edit_after_last_test",
              "verification.missing_final_verification",
              "verification.final_verification_failed",
              "verification.only_failed_verification",
              "reliability.repeated_failing_command",
              "tool_risk.destructive_command",
              "tool_risk.network_call_without_need",
              "scope.source_changed_without_test_change",
              "scope.broad_file_change"
            ]
          },
          "severity": { "enum": ["low", "medium", "high"] },
          "confidence": { "enum": ["medium", "high"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "kind", "display"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "kind": { "enum": ["file_change", "command"] },
                "display": { "type": "string" },
                "timestamp": { "type": "string" },
                "path": { "type": "string" },
                "operation": { "type": "string" },
                "command": { "type": "string" },
                "success": { "type": "boolean" },
                "output_excerpt": { "type": "string" }
              }
            }
          },
          "missing_evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "data_class", "artifact_id", "session_id", "type", "label", "media_type", "href", "digest", "created_at"],
        "additionalProperties": false,
        "properties": {
          "schema_version": { "const": "qratum.ui.artifact_link.v1" },
          "data_class": { "const": "published" },
          "artifact_id": { "type": "string" },
          "session_id": { "type": "string" },
          "type": { "enum": ["html_report", "adp_strict_export", "redacted_session", "evidence_bundle", "review_card", "share_card"] },
          "label": { "type": "string" },
          "media_type": { "type": "string" },
          "href": { "type": "string" },
          "digest": { "type": "string" },
          "created_at": { "type": "string" }
        }
      }
    }
  }
}
