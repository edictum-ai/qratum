{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/ui/evidence-finding.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "finding_id", "type", "severity", "confidence", "title", "summary", "evidence", "missing_evidence"],
  "properties": {
    "schema_version": { "const": "qratum.ui.evidence_finding.v1" },
    "type": {
      "enum": [
        "verification.final_edit_after_last_test",
        "verification.missing_final_verification",
        "reliability.repeated_failing_command",
        "redaction.secret_detected",
        "redaction.path_redacted"
      ]
    }
  }
}
