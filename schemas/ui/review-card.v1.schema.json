{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qratum.dev/schemas/ui/review-card.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "verdict", "main_finding", "evidence", "suggested_next_habit", "warnings"],
  "properties": {
    "schema_version": { "const": "qratum.ui.review_card.v1" },
    "session_id": { "type": "string" },
    "verdict": { "enum": ["clean", "needs_attention"] },
    "main_finding": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "suggested_next_habit": { "type": "string" },
    "suggested_skill": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } }
  }
}
